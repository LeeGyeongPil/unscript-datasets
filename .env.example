# All optional. unscript-datasets needs no key for public datasets.
# Token for gated/private datasets (otherwise they are reported as UNKNOWN/gated).
HF_TOKEN=
# Hub endpoint override read by huggingface_hub (mirrors).
# HF_ENDPOINT=https://huggingface.co
# UI language: en | ko (--lang wins, then this, then LC_ALL/LC_MESSAGES/LANG).
# UNSCRIPT_DATASETS_LANG=en
# Troubleshooting only: CA bundle if the OS trust store is unavailable (OSStatus -26276).
# SSL_CERT_FILE=/etc/ssl/cert.pem
